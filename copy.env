# Set the port on which Doge V5 will run on.
# PORT=2345

# Choose whether or not to use the Bare Server.
# Set to true or leave it alone if using Vercel.
# BARE="false"

# Choose whether or not you want to enable MASQR.
# Separate licensing server required for this to work.
# https://github.com/titaniumnetwork-dev/MasqrProject
# MASQR="false"

# Enable popunder overlay globally.
# POPUNDER_ENABLED="false"

# Popunder destination URL opened on click.
# POPUNDER_URL="https://example.com"

# Doge Messages persistent storage (mount a writable Railway Volume at /data)
# DOGEUB_DATA_DIR=/data/dogeub-messages
# Optional stable key for signing chat sessions; the generated key is stored in the data directory otherwise.
# DOGEUB_CHAT_SECRET=replace-with-a-long-random-secret
# Optional Vite dev proxy target when testing against a separate Node server.
# DOGEUB_API_PROXY=http://localhost:2345
